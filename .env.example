# Required to deliver website enquiries by email. Create a Resend API key.
# Without RESEND_API_KEY + CONTACT_TO_EMAIL the /api/contact route responds 503
# and the form directs visitors to info@afrifama.com / +254 716 438 604.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@afrifama.com
# Use a sender address verified in your Resend account.
CONTACT_FROM_EMAIL=

# Optional: override the bundled hero video without touching public/video.
NEXT_PUBLIC_HERO_VIDEO_URL=
